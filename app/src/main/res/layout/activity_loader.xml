<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/game_loading_screen_halloween"
        android:scaleType="centerCrop"/>
    <View
        android:id="@+id/view"
        android:background="@drawable/loadingscreen_bottom_gradient"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:alpha="0.9"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_percent="0.3"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/guideline2"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintGuide_percent="0.95"/>
    <TextView
        android:textSize="@dimen/_10sdp"
        android:textColor="@color/white"
        android:id="@+id/downloadSpeed"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/_3sdp"
        android:text="0 MB/s"
        android:shadowColor="@color/black"
        android:shadowRadius="5"
        android:fontFamily="@font/visby_round_cf_extra_bold"
        app:layout_constraintBottom_toTopOf="@+id/loadingProgress"
        app:layout_constraintEnd_toEndOf="@+id/loadingProgress"/>
    <TextView
        android:textSize="@dimen/_10sdp"
        android:textColor="@color/white"
        android:id="@+id/description"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/_3sdp"
        android:text="@string/downloading_game_files"
        android:shadowColor="@color/black"
        android:shadowRadius="5"
        android:fontFamily="@font/visby_round_cf_extra_bold"
        app:layout_constraintBottom_toTopOf="@+id/loadingProgress"
        app:layout_constraintStart_toStartOf="@+id/loadingProgress"/>
    <ProgressBar
        android:id="@+id/loadingProgress"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:progress="0"
        android:indeterminate="false"
        android:progressDrawable="@drawable/launcher_download_screen_progress"
        android:progressTint="#4caf50"
        app:layout_constraintBottom_toTopOf="@+id/guideline2"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_percent="0.017"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintWidth_percent="0.8"
        style="@style/Widget.AppCompat.ProgressBar.Horizontal"/>
</androidx.constraintlayout.widget.ConstraintLayout>